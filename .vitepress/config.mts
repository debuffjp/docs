import { existsSync, readFileSync } from "node:fs";
import { defineConfig } from "vitepress";
import { writeLlmsFull } from "./llms-full";

// Generated by `npm run api` (TypeDoc) from the debuff repo's sources.
const apiSidebarFile = new URL("../api/typedoc-sidebar.json", import.meta.url);
const apiSidebar = existsSync(apiSidebarFile) ? JSON.parse(readFileSync(apiSidebarFile, "utf8")) : [];

// The site serves from the domain root (Cloudflare); GitHub Pages builds set SITE_BASE=/docs/.
const base = process.env.SITE_BASE ?? "/";
// Where the site lives, for absolute links in social cards.
const origin = process.env.SITE_ORIGIN ?? "https://debuff.jp";
// Forums (forums.debuff.jp) are hidden while they are a work in progress.
/** The one canonical home for every page, whichever host built it (the GitHub Pages copy points here too). */
const CANONICAL = "https://debuff.jp";

/** Facts about debuff for search engines, as schema.org structured data (home page only). */
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "debuff",
  description: "An open-source TypeScript toolkit for small, fast 2D browser games, built to work with coding agents.",
  url: CANONICAL,
  codeRepository: "https://github.com/debuffjp/debuff",
  programmingLanguage: ["TypeScript", "JavaScript"],
  runtimePlatform: "Web browser",
  license: "https://opensource.org/licenses/MIT",
  keywords: "2D game engine, browser games, HTML5 games, WebGL2, game jam, AI coding agents, MCP",
  author: { "@type": "Organization", name: "Debuff Foundation", url: CANONICAL },
};

export default defineConfig({
  title: "debuff",
  description: "Agent-native toolkit for small, polished 2D web games. More room for play.",
  base,
  cleanUrls: true,
  sitemap: { hostname: CANONICAL },
  // The repo README is for contributors, not a page on the site.
  srcExclude: ["README.md"],
  buildEnd(site) {
    writeLlmsFull(site.srcDir, site.outDir, CANONICAL);
  },
  lastUpdated: true,
  appearance: "dark",
  head: [
    ["meta", { name: "theme-color", content: "#cffb2d" }],
    // Search engine ownership verification (Google Search Console, Bing Webmaster Tools).
    ["meta", { name: "google-site-verification", content: "EICOKV4M-kvzgj0yUEuEGQOEvV4H8KFLcy2H_49CmNw" }],
    ["meta", { name: "msvalidate.01", content: "8D3524238E187A30C4AFA9F534804EF5" }],
    ["link", { rel: "icon", href: `${base}mark.svg`, type: "image/svg+xml" }],
    ["meta", { property: "og:type", content: "website" }],
    ["meta", { property: "og:image", content: `${origin}/social-card.png` }],
    ["meta", { name: "twitter:card", content: "summary_large_image" }],
    ["meta", { name: "twitter:image", content: `${origin}/social-card.png` }],
  ],
  // Per page: canonical URL, Open Graph title/description/url, and structured data on the home page.
  transformPageData(page, { siteConfig }) {
    const path = page.relativePath.replace(/(^|\/)index\.md$/, "$1").replace(/\.md$/, "");
    const url = `${CANONICAL}/${path}`;
    const title = page.frontmatter.layout === "home" ? (page.frontmatter.title ?? siteConfig.site.title) : `${page.title} | debuff`;
    const description = page.frontmatter.description ?? page.description ?? siteConfig.site.description;
    page.frontmatter.head ??= [];
    page.frontmatter.head.push(
      ["link", { rel: "canonical", href: url }],
      ["meta", { property: "og:url", content: url }],
      ["meta", { property: "og:title", content: title }],
      ["meta", { property: "og:description", content: description }],
    );
    if (page.frontmatter.layout === "home") {
      page.frontmatter.head.push(["script", { type: "application/ld+json" }, JSON.stringify(softwareLd)]);
    }
    // Blog posts: Article structured data, and the article type for social cards.
    if (/^blog\/(?!index\.md$)/.test(page.relativePath)) {
      const date = new Date(page.frontmatter.date).toISOString().slice(0, 10);
      page.frontmatter.head.push(
        ["meta", { property: "og:type", content: "article" }],
        ["meta", { property: "article:published_time", content: date }],
        [
          "script",
          { type: "application/ld+json" },
          JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Article",
            headline: page.frontmatter.title,
            description,
            url,
            mainEntityOfPage: url,
            datePublished: date,
            dateModified: page.lastUpdated ? new Date(page.lastUpdated).toISOString() : date,
            image: `${CANONICAL}/social-card.png`,
            author: { "@type": "Organization", name: "Debuff Foundation", url: CANONICAL },
            publisher: { "@type": "Organization", name: "Debuff Foundation", url: CANONICAL },
          }),
        ],
      );
    }
  },
  themeConfig: {
    // The Debuff Foundation mark; buff stays the mascot in games, the dev panel and the splash.
    logo: { src: "/mark.svg", alt: "" },
    siteTitle: "debuff",
    nav: [
      { text: "Docs", link: "/docs/getting-started", activeMatch: "^/docs/" },
      { text: "Examples", link: "/examples" },
      { text: "Benchmarks", link: "/benchmarks" },
      { text: "Blog", link: "/blog/", activeMatch: "^/blog/" },
      { text: "API", link: "/api/", activeMatch: "^/api/" },
      { text: "Roadmap", link: "https://github.com/debuffjp/debuff/blob/main/docs/roadmap.md" },
      // Styled as the primary button (lime.css).
      { text: "Build your first game", link: "/docs/getting-started#create-a-game" },
    ],
    sidebar: {
      "/docs/": [
        {
          text: "Start",
          items: [
            { text: "Why debuff", link: "/docs/why" },
            { text: "Getting started", link: "/docs/getting-started" },
            { text: "Core concepts", link: "/docs/concepts" },
            { text: "Without a build step", link: "/docs/no-build" },
          ],
        },
        {
          text: "Making games",
          items: [
            { text: "Drawing", link: "/docs/drawing" },
            { text: "Input", link: "/docs/input" },
            { text: "Assets", link: "/docs/assets" },
            { text: "Tilemaps and collision", link: "/docs/tilemaps" },
            { text: "Tunable params", link: "/docs/params" },
          ],
        },
        {
          text: "Tooling",
          items: [
            { text: "Testing with scenarios", link: "/docs/scenarios" },
            { text: "Desktop builds", link: "/docs/desktop" },
            { text: "Working with AI agents", link: "/docs/agents" },
            { text: "Plugins", link: "/docs/plugins" },
          ],
        },
      ],
      "/blog/": [
        {
          text: "Blog",
          items: [
            { text: "Coding agents: how debuff compares", link: "/blog/coding-agents-and-browser-game-engines" },
            { text: "Build a game with Claude Code", link: "/blog/build-a-game-with-claude-code" },
            { text: "Make a game with an AI agent", link: "/blog/make-a-browser-game-with-an-ai-coding-agent" },
            { text: "debuff vs PixiJS vs Phaser", link: "/blog/debuff-vs-pixijs-vs-phaser" },
            { text: "debuff vs Phaser", link: "/blog/debuff-vs-phaser" },
            { text: "debuff vs PixiJS", link: "/blog/debuff-vs-pixijs" },
            { text: "debuff vs KAPLAY", link: "/blog/debuff-vs-kaplay" },
            { text: "debuff vs Excalibur", link: "/blog/debuff-vs-excalibur" },
            { text: "debuff vs Godot", link: "/blog/debuff-vs-godot" },
            { text: "Pixel-art platformer", link: "/blog/pixel-art-platformer-in-the-browser" },
            { text: "Replays and fuzzing", link: "/blog/testing-games-with-replays-and-fuzzing" },
            { text: "Game jam to itch.io", link: "/blog/game-jam-zero-to-itch-io" },
          ],
        },
      ],
      "/api/": [{ text: "API reference", items: apiSidebar }],
    },
    socialLinks: [
      { icon: "github", link: "https://github.com/debuffjp/debuff" },
    ],
    editLink: { pattern: "https://github.com/debuffjp/docs/edit/main/:path", text: "Edit this page" },
    search: { provider: "local" },
    footer: { message: `MIT licensed · <a href="https://github.com/debuffjp/debuff">GitHub</a> · <a href="${base}privacy">Privacy</a>` },
  },
});
